# Copy this to `.env` in the deploy directory ON THE SERVER (not in the
# repo) and fill in real values. This file stays on the server permanently
# — deploys never touch it.
#
# NEVER QUOTE VALUES IN THIS FILE. docker-compose reads it via `env_file:`,
# and unlike a shell, that reader does NOT strip surrounding quotes:
# FOO="bar" arrives inside the container as the literal string `"bar"`.
# Values with spaces need no quoting; everything after the first `=` is the
# value.

NODE_ENV=production

# Public domain this container is served on. Read by docker-compose.prod.yml
# to label the container for the standalone `edge` Caddy (caddy-docker-proxy),
# which picks up routing and requests its Let's Encrypt certificate from this
# value automatically — there is no Caddyfile to edit by hand.
DOMAIN=kitoblarim.uz

# Server-side (Server Components) calls Reads-admin directly over the
# shared Docker network by container name — never leaves the box, and
# works even before dashboard.kitoblarim.uz's certificate exists.
API_URL=http://reads-admin-app:80/api
# Where covers can be fetched from the outside (og:image, structured data).
# Defaults to https://dashboard.kitoblarim.uz.
# PUBLIC_ASSET_URL=https://dashboard.kitoblarim.uz

# The inquiry form posts to this site's own /api/inquiries, which forwards
# it to API_URL above — the browser never needs the admin's address, and
# nothing here is baked into the image. The same image runs on staging and
# production; only this file differs.

# Public origin of this site. Canonical URLs, hreflang, the sitemap and
# og:image URLs are all built from it.
SITE_URL=https://kitoblarim.uz

SITE_NAME=Kitoblarim

# Must match SEO_REVALIDATE_SECRET in Reads-admin's server .env, or the
# revalidation webhook is rejected and content changes only appear after the
# 5-minute ISR window. The site also sends it to the API as a bearer token, so
# Reads-admin's rate limiter gives it the site's bucket instead of a
# stranger's 120 requests a minute (which a crawl turns into 500s).
# Generate once with: openssl rand -hex 32
REVALIDATE_SECRET=

# ---- staging only ----------------------------------------------------------
# Leave unset in production.
#
# Staging has no Reads-admin of its own yet, so it reads production's
# (API_URL above) — and must never file a test inquiry with real
# translators. The form answers with an error instead.
# INQUIRIES_DISABLED=true
