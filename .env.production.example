# Copy this to `.env` in the deploy directory ON THE SERVER (not in the
# repo) and fill in real values. This file stays on the server permanently
# — deploys never touch it.

NODE_ENV=production

# Server-side (Server Components) calls Reads-admin directly over the
# shared Docker network by container name — never leaves the box, and
# works even before dashboard.kitoblarim.uz's certificate exists.
API_URL=http://reads-admin-app:80/api

# NEXT_PUBLIC_API_URL is NOT read from here. Next.js inlines NEXT_PUBLIC_*
# vars into the client bundle at build time, so it has to be a Docker build
# arg instead — set in .github/workflows/deploy.yml, baked into the image
# before it ever reaches this server. Setting it in this file would have no
# effect on the already-built bundle. To change it, edit the workflow and
# redeploy.
