# Add this block to the Caddyfile your existing Caddy container already
# reads (the same one serving kitoblarim and my-blog), then reload Caddy —
# it will request/renew the Let's Encrypt certificate for
# tarjima.kitoblarim.uz automatically the first time it's requested.

tarjima.kitoblarim.uz {
    reverse_proxy reads-app:3000
}

# Reload without downtime, from wherever your Caddy compose file lives:
#   docker exec <caddy-container-name> caddy reload --config /etc/caddy/Caddyfile
