# Base URL of the Reads-admin Laravel API, used for server-side rendering
# (Server Components fetch this directly, never sent to the browser).
# Defaults to http://localhost:8000/api if unset — that's Laravel Sail's
# default port when running Reads-admin with `sail up`.
#
# If this app runs inside its own Docker container (docker compose up) and
# needs to reach Reads-admin running via Sail on the host, use:
# API_URL=http://host.docker.internal:8000/api
API_URL=http://localhost:8000/api

# Same API, but for the visitor's own browser to call directly (the inquiry
# form submits client-side). This must always be an address the browser
# itself can reach — host.docker.internal means nothing outside a
# container, so this stays "localhost" even when the API_URL above needs
# to be host.docker.internal for server-side Docker-to-Docker calls.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Absolute origin this site is served from. Every canonical URL, hreflang
# alternate, sitemap entry and og:image is built from it — a wrong value
# here mislabels the whole site to search engines. Server-side only, read at
# runtime (no NEXT_PUBLIC_ prefix, so it is not baked into the build).
SITE_URL=http://localhost:3000

# Brand name used in <title>, og:site_name and llms.txt.
SITE_NAME=Reads

# Shared secret for POST /api/revalidate, the webhook Reads-admin calls after
# every save so a new book appears (and enters the sitemap) immediately
# instead of waiting out the ISR window. Must match SEO_REVALIDATE_SECRET in
# Reads-admin's .env. Generate one with: openssl rand -hex 32
# Leave unset locally and the endpoint refuses every call, which is the safe
# default — an unset secret must never mean "no authentication required".
REVALIDATE_SECRET=
